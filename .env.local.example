# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# E-mail que recebe os leads do formulário de contato
CONTACT_EMAIL_TO=contato@kivo.com.br

# Remetente dos e-mails (domínio precisa estar verificado no Resend;
# enquanto não estiver, use onboarding@resend.dev)
CONTACT_EMAIL_FROM=Kivo Site <onboarding@resend.dev>

# URL pública do site (usada em canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://kivo.com.br
